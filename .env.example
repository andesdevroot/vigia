# Copia este archivo a .env y pega los valores. `.env` no se versiona.
#
#     cp .env.example .env
#
# Antes de probar, lee `doc/10-CORRER.md`.

# --- Kapso: el canal de WhatsApp ---

# Del panel de Kapso: tu proyecto -> API keys.
KAPSO_API_KEY=

# Lo entrega Kapso **al crear el webhook**, y lo muestra UNA SOLA VEZ.
# Si se pierde, hay que crear otro webhook.
VIGIA_WEBHOOK_SECRET=

# Lo escribe `scripts/probar_local.sh` al registrar el webhook.
VIGIA_WEBHOOK_ID=

# Casi nunca hay que tocarlas.
KAPSO_API_BASE_URL=https://api.kapso.ai
VIGIA_PUERTO=8000

# --- Extractores: los modelos que llenan el formulario de la petición ---
#
# Son OPCIONALES y van por separado: el motor funciona sin ninguno de los dos, y cada uno se
# enciende con su propia clave. `scripts/comparar_extractores.py` los enfrenta.

# DeepSeek, API directa. Modelo `deepseek-chat` (V3).
# Precio medido en OpenRouter el 2026-10-11: USD 0,32 por millón de tokens de entrada.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELO=deepseek-chat

# JEV de TypeSafe, **vía OpenRouter**: no tiene API pública propia y se sirve por ahí.
# El identificador verificado es `typesafe/jev-router`, no `jev-1.13`.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JEV_MODELO=typesafe/jev-router

# Cuántos mensajes del corpus se le mandan a cada modelo al comparar: cada uno cuesta dinero.
VIGIA_MUESTRA_EXTRACTORES=40
